<script>
$(function () {
  var policyDatasets = <?=json_encode(array_column($datasets, 'name'), JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT)?>;

  function showTab(name) {
    if ($('[data-zsm-tab="' + name + '"]').length === 0) {
      name = 'overview';
    }
    $('[data-zsm-tab]').each(function () {
      var active = $(this).data('zsm-tab') === name;
      $(this).toggleClass('zsm-tab-active', active).attr('aria-selected', active ? 'true' : 'false');
    });
    $('[data-zsm-panel]').each(function () {
      $(this).toggle($(this).data('zsm-panel') === name);
    });
    try {
      window.sessionStorage.setItem('zsm-tab', name);
    } catch (error) {
      // Ohne Speicher startet die Seite nach dem Neuladen wieder auf der Übersicht.
    }
  }

  $('[data-zsm-tab]').on('click', function () {
    showTab(String($(this).data('zsm-tab')));
  });

  var storedTab = 'overview';
  try {
    storedTab = window.sessionStorage.getItem('zsm-tab') || 'overview';
  } catch (error) {
    storedTab = 'overview';
  }
  showTab(storedTab);

  var datasetsOpen = false;
  try {
    datasetsOpen = window.sessionStorage.getItem('zsm-datasets-open') === '1';
  } catch (error) {
    datasetsOpen = false;
  }
  $('#zsm-datasets').prop('open', datasetsOpen).on('toggle', function () {
    try {
      window.sessionStorage.setItem('zsm-datasets-open', this.open ? '1' : '0');
    } catch (error) {
      // Ohne Speicher bleibt der Bereich nach dem Neuladen eingeklappt.
    }
  });

  function sortValue(row, index, type) {
    var cell = row.children().eq(index);
    var raw = cell.attr('data-sort-value');
    if (type === 'number') {
      var number = parseFloat(raw === undefined ? cell.text() : raw);
      return isNaN(number) ? -1 : number;
    }
    return $.trim(cell.text());
  }

  function sortTable(header) {
    var table = header.closest('table');
    var body = table.children('tbody');
    var rows = body.children('tr').get().map(function (row) { return $(row); });
    if (rows.length < 2) {
      return;
    }
    var index = header.index();
    var type = String(header.attr('data-sort'));
    var direction = header.attr('aria-sort') === 'ascending' ? -1 : 1;
    rows.sort(function (first, second) {
      var a = sortValue(first, index, type);
      var b = sortValue(second, index, type);
      var result = type === 'number' ? a - b : a.localeCompare(b, 'de', { numeric: true, sensitivity: 'base' });
      return result * direction;
    });
    table.find('th[aria-sort]').removeAttr('aria-sort');
    header.attr('aria-sort', direction === 1 ? 'ascending' : 'descending');
    rows.forEach(function (row) { body.append(row); });
  }

  $('th[data-sort]').attr('tabindex', '0').on('click', function () {
    sortTable($(this));
  }).on('keydown', function (event) {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      sortTable($(this));
    }
  });

  function showMessage(text, isError) {
    $('#zsm-message')
      .removeClass('zsm-error zsm-success')
      .addClass(isError ? 'zsm-error' : 'zsm-success')
      .text(text)
      .show();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updatePolicyFields() {
    var frequency = $('#zsm-policy-frequency').val();
    $('#zsm-policy-hour-wrap').toggle(frequency !== 'hourly');
    $('#zsm-policy-weekday-wrap').toggle(frequency === 'weekly');
  }

  function updatePolicyScope() {
    var root = String($('#zsm-policy-dataset').val() || '');
    var recursive = $('#zsm-policy-recursive').prop('checked');
    var affected = policyDatasets.filter(function (name) {
      return name === root || (recursive && name.indexOf(root + '/') === 0);
    });
    $('#zsm-policy-scope').text(
      recursive
        ? 'Betroffene Datasets (' + affected.length + '): ' + affected.join(', ')
        : 'Betroffenes Dataset: ' + root
    );
  }

  $('#zsm-policy-frequency').on('change', updatePolicyFields);
  $('#zsm-policy-dataset, #zsm-policy-recursive').on('change', updatePolicyScope);
  updatePolicyFields();
  updatePolicyScope();

  $('#zsm-policy-form').on('submit', function (event) {
    event.preventDefault();
    var button = $('#zsm-policy-add');
    var saveLabel = $('#zsm-policy-id').val() ? 'Änderungen speichern' : 'Zeitplan speichern';
    if ($('#zsm-policy-recursive').prop('checked') && !window.confirm(
      'Der Zeitplan wird für das gewählte Dataset und alle angezeigten Unter-Datasets ausgeführt. Fortfahren?'
    )) {
      return;
    }
    button.prop('disabled', true).text('Wird gespeichert...');
    $.ajax({
      url: '/plugins/zfs.snapshot.manager/include/policies.php',
      method: 'POST',
      dataType: 'json',
      data: {
        csrf_token: <?=json_encode($csrfToken, JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT)?>,
        action: 'save',
        id: $('#zsm-policy-id').val(),
        dataset: $('#zsm-policy-dataset').val(),
        recursive: $('#zsm-policy-recursive').prop('checked') ? '1' : '0',
        frequency: $('#zsm-policy-frequency').val(),
        minute: $('#zsm-policy-minute').val(),
        hour: $('#zsm-policy-hour').val(),
        weekday: $('#zsm-policy-weekday').val(),
        retention_value: $('#zsm-policy-retention-value').val(),
        retention_unit: $('#zsm-policy-retention-unit').val()
      }
    }).done(function (response) {
      showMessage(response.message, false);
      window.setTimeout(function () { window.location.reload(); }, 700);
    }).fail(function (xhr) {
      showMessage((xhr.responseJSON || {}).message || 'Der Zeitplan konnte nicht gespeichert werden.', true);
      button.prop('disabled', false).text(saveLabel);
    });
  });

  $('.zsm-policy-edit').on('click', function () {
    var button = $(this);
    $('#zsm-policy-id').val(String(button.attr('data-id') || ''));
    $('#zsm-policy-dataset').val(String(button.attr('data-dataset') || ''));
    $('#zsm-policy-dataset').prop('disabled', true);
    $('#zsm-policy-frequency').val(String(button.attr('data-frequency') || 'hourly'));
    $('#zsm-policy-minute').val(String(button.attr('data-minute') || '0'));
    $('#zsm-policy-hour').val(String(button.attr('data-hour') || '0'));
    $('#zsm-policy-weekday').val(String(button.attr('data-weekday') || '0'));
    $('#zsm-policy-retention-value').val(String(button.attr('data-retention-value') || '1'));
    $('#zsm-policy-retention-unit').val(String(button.attr('data-retention-unit') || 'days'));
    $('#zsm-policy-recursive').prop('checked', String(button.attr('data-recursive') || '0') === '1');
    $('#zsm-policy-add').text('Änderungen speichern');
    $('#zsm-policy-cancel').show();
    updatePolicyFields();
    updatePolicyScope();
    document.getElementById('zsm-policy-form').scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  $('#zsm-policy-cancel').on('click', function () {
    $('#zsm-policy-id').val('');
    $('#zsm-policy-dataset').prop('disabled', false);
    $('#zsm-policy-recursive').prop('checked', false);
    $('#zsm-policy-add').text('Zeitplan speichern');
    $(this).hide();
    updatePolicyScope();
  });

  function policyRequest(button, action, waitingLabel) {
    var id = String(button.data('id') || '');
    var originalLabel = button.text();
    button.prop('disabled', true).text(waitingLabel);
    $.ajax({
      url: '/plugins/zfs.snapshot.manager/include/policies.php',
      method: 'POST',
      dataType: 'json',
      data: {
        csrf_token: <?=json_encode($csrfToken, JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT)?>,
        action: action,
        id: id
      }
    }).done(function (response) {
      var text = response.message;
      if (action === 'preview' && response.candidates && response.candidates.length) {
        text += ' ' + response.candidates.join(', ');
      }
      if (action === 'run' && response.snapshot) {
        text += ' ' + response.snapshot;
      }
      showMessage(text, false);
      if (action === 'delete' || action === 'run') {
        window.setTimeout(function () { window.location.reload(); }, 900);
      } else {
        button.prop('disabled', false).text(originalLabel);
      }
    }).fail(function (xhr) {
      showMessage((xhr.responseJSON || {}).message || 'Die Aktion ist fehlgeschlagen.', true);
      button.prop('disabled', false).text(originalLabel);
    });
  }

  $('.zsm-policy-run').on('click', function () {
    policyRequest($(this), 'run', 'Wird ausgeführt...');
  });
  $('.zsm-policy-preview').on('click', function () {
    policyRequest($(this), 'preview', 'Wird geprüft...');
  });
  $('.zsm-policy-delete').on('click', function () {
    if (window.confirm('Zeitplan wirklich löschen? Bereits vorhandene Snapshots bleiben erhalten.')) {
      policyRequest($(this), 'delete', 'Wird gelöscht...');
    }
  });

  function suggestShareName() {
    if ($('#zsm-share-id').val()) {
      return;
    }
    var dataset = String($('#zsm-share-dataset option:selected').attr('data-name') || '');
    $('#zsm-share-name').val('snapshot-' + dataset.split('/').pop().replace(/[^A-Za-z0-9_-]/g, '-'));
  }

  function resetShareForm() {
    $('#zsm-share-id').val('');
    $('#zsm-share-dataset').prop('disabled', false);
    $('.zsm-share-user').prop('checked', false);
    $('#zsm-share-save').text('Freigabe speichern');
    $('#zsm-share-cancel').hide();
    suggestShareName();
  }

  function shareRequest(data, fallbackMessage, onFail) {
    data.csrf_token = <?=json_encode($csrfToken, JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT)?>;
    $.ajax({
      url: '/plugins/zfs.snapshot.manager/include/shares.php',
      method: 'POST',
      dataType: 'json',
      data: data
    }).done(function (response) {
      showMessage(response.message, false);
      window.setTimeout(function () { window.location.reload(); }, 900);
    }).fail(function (xhr) {
      showMessage((xhr.responseJSON || {}).message || fallbackMessage, true);
      onFail();
    });
  }

  $('#zsm-share-dataset').on('change', suggestShareName);
  suggestShareName();

  $('#zsm-share-form').on('submit', function (event) {
    event.preventDefault();
    var button = $('#zsm-share-save');
    var label = button.text();
    var users = $('.zsm-share-user:checked').map(function () { return this.value; }).get();
    if (!users.length) {
      showMessage('Mindestens ein Benutzer muss ausgewählt werden.', true);
      return;
    }
    button.prop('disabled', true).text('Wird gespeichert...');
    shareRequest({
      action: 'save',
      id: $('#zsm-share-id').val(),
      dataset_guid: $('#zsm-share-dataset').val(),
      name: $('#zsm-share-name').val(),
      users: users
    }, 'Die Freigabe konnte nicht gespeichert werden.', function () {
      button.prop('disabled', false).text(label);
    });
  });

  $('.zsm-share-edit').on('click', function () {
    var button = $(this);
    var users = String(button.attr('data-users') || '').split(' ');
    $('#zsm-share-id').val(String(button.attr('data-id') || ''));
    $('#zsm-share-dataset').val(String(button.attr('data-guid') || '')).prop('disabled', true);
    $('#zsm-share-name').val(String(button.attr('data-name') || ''));
    $('.zsm-share-user').each(function () {
      this.checked = users.indexOf(this.value) !== -1;
    });
    $('#zsm-share-save').text('Änderungen speichern');
    $('#zsm-share-cancel').show();
    document.getElementById('zsm-share-form').scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  $('#zsm-share-cancel').on('click', resetShareForm);

  $('.zsm-share-delete').on('click', function () {
    var button = $(this);
    if (!window.confirm('Freigabe wirklich entfernen? Snapshots und Daten bleiben erhalten.')) {
      return;
    }
    button.prop('disabled', true).text('Wird entfernt...');
    shareRequest({ action: 'delete', id: String(button.data('id') || '') }, 'Die Freigabe konnte nicht entfernt werden.', function () {
      button.prop('disabled', false).text('Freigabe entfernen');
    });
  });

  $('#zsm-create-form').on('submit', function (event) {
    event.preventDefault();

    var button = $('#zsm-create-button');
    var message = $('#zsm-message');
    button.prop('disabled', true).text('Snapshot wird erstellt...');
    message.hide().removeClass('zsm-error zsm-success');

    $.ajax({
      url: '/plugins/zfs.snapshot.manager/include/action.php',
      method: 'POST',
      dataType: 'json',
      data: {
        csrf_token: <?=json_encode($csrfToken, JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT)?>,
        action: 'create',
        dataset: $('#zsm-dataset').val()
      }
    }).done(function (response) {
      message.addClass('zsm-success').text(response.message + ' ' + response.snapshot).show();
      window.setTimeout(function () { window.location.reload(); }, 900);
    }).fail(function (xhr) {
      var response = xhr.responseJSON || {};
      message.addClass('zsm-error').text(response.message || 'Der Snapshot konnte nicht erstellt werden.').show();
      button.prop('disabled', false).text('Snapshot erstellen');
    });
  });

  $('.zsm-delete-button').on('click', function () {
    var button = $(this);
    var snapshot = String(button.data('snapshot') || '');
    var external = String(button.data('external')) === '1';
    var originalLabel = external ? 'Extern löschen' : 'Löschen';
    var message = $('#zsm-message');
    var action = external ? 'delete-external' : 'delete';
    message.hide().removeClass('zsm-error zsm-success');

    var confirmation = 'Snapshot wirklich unwiderruflich löschen?\n\n' + snapshot + '\n\nDiese Aktion kann nicht rückgängig gemacht werden.';
    if (external) {
      confirmation = 'Dieser Snapshot wurde nicht von diesem Plugin erstellt.\n\n' + confirmation;
    }
    if (!window.confirm(confirmation)) {
      return;
    }

    button.prop('disabled', true).text('Wird gelöscht...');

    var requestData = {
      csrf_token: <?=json_encode($csrfToken, JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT)?>,
      action: action,
      snapshot: snapshot
    };
    if (external) {
      requestData.confirmation = snapshot;
    }

    $.ajax({
      url: '/plugins/zfs.snapshot.manager/include/action.php',
      method: 'POST',
      dataType: 'json',
      data: requestData
    }).done(function (response) {
      message.addClass('zsm-success').text(response.message + ' ' + response.snapshot).show();
      window.setTimeout(function () { window.location.reload(); }, 900);
    }).fail(function (xhr) {
      var response = xhr.responseJSON || {};
      message.addClass('zsm-error').text(response.message || 'Der Snapshot konnte nicht gelöscht werden.').show();
      button.prop('disabled', false).text(originalLabel);
    });
  });
});
</script>

<?php endif; ?>

