                  && preg_match('/@uzm_auto_[a-f0-9]{32}_[0-9]{8}T[0-9]{6}Z$/D', $snapshot['name']) === 1);
          $hasClones = $snapshot['clones'] !== '' && $snapshot['clones'] !== '-';
