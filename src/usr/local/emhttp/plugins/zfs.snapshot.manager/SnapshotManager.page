<?php
require_once "$docroot/plugins/zfs.snapshot.manager/include/lib.php";

$pluginEnabled = zsm_is_enabled();

if (!$pluginEnabled):
?>
<div class="zsm-notice">
  Der ZFS Snapshot Manager ist deaktiviert. Aktiviere ihn unter <a href="/Settings/ZFSSnapshotManager">Einstellungen &gt; ZFS Snapshot Manager</a>.
</div>
<?php
else:

$datasetResult = zsm_run(['list-datasets']);
$snapshotResult = zsm_run(['list-snapshots']);

$datasets = $datasetResult['exitCode'] === 0
    ? zsm_parse_tsv($datasetResult['stdout'], ['name', 'type', 'used', 'available', 'referenced', 'mountpoint'])
    : [];
$snapshots = $snapshotResult['exitCode'] === 0
    ? zsm_parse_tsv($snapshotResult['stdout'], ['name', 'creation', 'used', 'referenced', 'clones', 'kind'])
    : [];

$errors = [];
if ($datasetResult['exitCode'] !== 0) {
    $errors[] = $datasetResult['stderr'] ?: 'Datasets konnten nicht geladen werden.';
}
if ($snapshotResult['exitCode'] !== 0) {
    $errors[] = $snapshotResult['stderr'] ?: 'Snapshots konnten nicht geladen werden.';
}

$csrfToken = isset($var['csrf_token']) ? (string) $var['csrf_token'] : '';
$arrayState = strtoupper((string) ($var['mdState'] ?? 'UNKNOWN'));
$arrayStarted = $arrayState === 'STARTED';
$arrayStateLabels = [
    'STARTED' => 'Gestartet',
    'STARTING' => 'Wird gestartet',
    'STOPPED' => 'Gestoppt',
    'STOPPING' => 'Wird gestoppt',
    'UNKNOWN' => 'Unbekannt',
];
$arrayStateLabel = $arrayStateLabels[$arrayState] ?? $arrayState;
?>

<style>
