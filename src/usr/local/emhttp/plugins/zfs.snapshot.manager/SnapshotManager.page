  Testversion <?=zsm_h(ZSM_VERSION)?>: Manuelle Plugin-Snapshots können erstellt und nach einer Sicherheitsprüfung wieder gelöscht werden. Rollback, Retention und Zeitpläne sind nicht enthalten.
</div>

<?php if (!$arrayStarted && !$datasets): ?>
  <div class="zsm-notice">
    Das Unraid-Array ist aktuell „<?=zsm_h($arrayStateLabel)?>“. Starte das Array unter „Main“ und klicke anschließend auf „Aktualisieren“.
  </div>
<?php endif; ?>

<?php foreach ($errors as $error): ?>
  <div class="zsm-notice zsm-error"><?=zsm_h($error)?></div>
<?php endforeach; ?>

<div id="zsm-message" class="zsm-notice" style="display:none"></div>

<div class="zsm-summary">
  <div class="zsm-card">
    <span>Unraid-Array</span>
    <strong class="<?=$arrayStarted ? 'zsm-state-good' : 'zsm-state-warn'?>"><?=zsm_h($arrayStateLabel)?></strong>
  </div>
  <div class="zsm-card"><span>Datasets und ZVOLs</span><strong><?=count($datasets)?></strong></div>
  <div class="zsm-card"><span>Snapshots</span><strong><?=count($snapshots)?></strong></div>
  <div class="zsm-card"><span>Schreibfunktionen</span><strong>2</strong><span class="zsm-muted">Erstellen und sicheres Löschen</span></div>
</div>

<section class="zsm-panel">
  <h2>Manuellen Snapshot erstellen</h2>
  <p>Der Name wird sicher und eindeutig aus der UTC-Zeit erzeugt. Es werden keine vorhandenen Daten überschrieben.</p>
  <?php if ($datasets): ?>
    <form id="zsm-create-form" class="zsm-actions" method="post">
      <label for="zsm-dataset">Dataset:</label>
      <select id="zsm-dataset" name="dataset" required>
        <?php foreach ($datasets as $dataset): ?>
          <option value="<?=zsm_h($dataset['name'])?>"><?=zsm_h($dataset['name'])?> (<?=zsm_h($dataset['type'])?>)</option>
        <?php endforeach; ?>
      </select>
      <button id="zsm-create-button" type="submit">Snapshot erstellen</button>
    </form>
  <?php elseif (!$arrayStarted): ?>
    <p class="zsm-muted">Nach dem Array-Start stehen die ZFS-Datasets zur Auswahl.</p>
  <?php else: ?>
    <p class="zsm-muted">Kein verwendbares ZFS-Dataset gefunden.</p>
  <?php endif; ?>
</section>

<section class="zsm-panel">
  <h2>Datasets</h2>
  <div class="zsm-table-wrap">
    <table class="zsm-table">
      <thead><tr><th>Name</th><th>Typ</th><th>Belegt</th><th>Verfügbar</th><th>Referenziert</th><th>Mountpoint</th></tr></thead>
      <tbody>
      <?php if (!$datasets && !$arrayStarted): ?>
        <tr><td colspan="6">Das Array ist noch nicht gestartet.</td></tr>
      <?php elseif (!$datasets): ?>
        <tr><td colspan="6">Keine ZFS-Datasets gefunden.</td></tr>
      <?php else: ?>
        <?php foreach ($datasets as $dataset): ?>
          <tr>
            <td><?=zsm_h($dataset['name'])?></td>
            <td><?=zsm_h($dataset['type'])?></td>
            <td><?=zsm_h(zsm_format_bytes($dataset['used']))?></td>
            <td><?=zsm_h(zsm_format_bytes($dataset['available']))?></td>
            <td><?=zsm_h(zsm_format_bytes($dataset['referenced']))?></td>
            <td><?=zsm_h($dataset['mountpoint'])?></td>
          </tr>
        <?php endforeach; ?>
      <?php endif; ?>
      </tbody>
    </table>
  </div>
</section>

<section class="zsm-panel">
  <h2>Snapshots</h2>
  <p>Gelöscht werden können nur eindeutig gekennzeichnete manuelle Snapshots dieses Plugins. Snapshots mit Klonen oder ZFS-Holds werden serverseitig abgelehnt.</p>
  <div class="zsm-table-wrap">
    <table class="zsm-table">
      <thead><tr><th>Name</th><th>Erstellt</th><th>Belegt</th><th>Referenziert</th><th>Klone</th><th>Aktion</th></tr></thead>
      <tbody>
      <?php if (!$snapshots && !$arrayStarted): ?>
        <tr><td colspan="6">Das Array ist noch nicht gestartet.</td></tr>
      <?php elseif (!$snapshots): ?>
        <tr><td colspan="6">Keine Snapshots gefunden.</td></tr>
      <?php else: ?>
        <?php foreach (array_reverse($snapshots) as $snapshot): ?>
          <?php
          $isPluginSnapshot = $snapshot['kind'] === 'manual'
              && preg_match('/@uzm_manual_[0-9]{8}T[0-9]{6}Z$/D', $snapshot['name']) === 1;
          $hasClones = $snapshot['clones'] !== '' && $snapshot['clones'] !== '-';
          ?>
          <tr>
            <td><?=zsm_h($snapshot['name'])?></td>
            <td><?=zsm_h(zsm_format_timestamp($snapshot['creation']))?></td>
            <td><?=zsm_h(zsm_format_bytes($snapshot['used']))?></td>
            <td><?=zsm_h(zsm_format_bytes($snapshot['referenced']))?></td>
            <td><?=zsm_h($snapshot['clones'])?></td>
            <td>
              <?php if (!$isPluginSnapshot): ?>
                <span class="zsm-muted">Nicht vom Plugin</span>
              <?php elseif ($hasClones): ?>
                <span class="zsm-muted">Klone vorhanden</span>
              <?php else: ?>
                <button type="button" class="zsm-delete-button zsm-danger" data-snapshot="<?=zsm_h($snapshot['name'])?>">Löschen</button>
              <?php endif; ?>
            </td>
          </tr>
        <?php endforeach; ?>
      <?php endif; ?>
      </tbody>
    </table>
  </div>
</section>

<script>
$(function () {
  $('#zsm-create-form').on('submit', function (event) {
    event.preventDefault();

    var button = $('#zsm-create-button');
    var message = $('#zsm-message');
    button.prop('disabled', true).text('Snapshot wird erstellt...');
    message.hide().removeClass('zsm-error zsm-success');

    $.ajax({
      url: '/plugins/zfs.snapshot.manager/include/action.php',
      method: 'POST',
      dataType: 'json',
      data: {
        csrf_token: <?=json_encode($csrfToken, JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT)?>,
        action: 'create',
        dataset: $('#zsm-dataset').val()
      }
    }).done(function (response) {
      message.addClass('zsm-success').text(response.message + ' ' + response.snapshot).show();
      window.setTimeout(function () { window.location.reload(); }, 900);
    }).fail(function (xhr) {
      var response = xhr.responseJSON || {};
      message.addClass('zsm-error').text(response.message || 'Der Snapshot konnte nicht erstellt werden.').show();
      button.prop('disabled', false).text('Snapshot erstellen');
    });
  });

  $('.zsm-delete-button').on('click', function () {
    var button = $(this);
    var snapshot = String(button.data('snapshot') || '');
    var message = $('#zsm-message');
    var confirmation = 'Snapshot wirklich unwiderruflich löschen?\n\n' + snapshot + '\n\nDiese Aktion kann nicht rückgängig gemacht werden.';

    if (!window.confirm(confirmation)) {
      return;
    }

    button.prop('disabled', true).text('Wird gelöscht...');
    message.hide().removeClass('zsm-error zsm-success');

    $.ajax({
      url: '/plugins/zfs.snapshot.manager/include/action.php',
      method: 'POST',
      dataType: 'json',
      data: {
        csrf_token: <?=json_encode($csrfToken, JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT)?>,
        action: 'delete',
        snapshot: snapshot
      }
    }).done(function (response) {
      message.addClass('zsm-success').text(response.message + ' ' + response.snapshot).show();
      window.setTimeout(function () { window.location.reload(); }, 900);
    }).fail(function (xhr) {
      var response = xhr.responseJSON || {};
      message.addClass('zsm-error').text(response.message || 'Der Snapshot konnte nicht gelöscht werden.').show();
      button.prop('disabled', false).text('Löschen');
    });
  });
});
</script>

<?php endif; ?>

